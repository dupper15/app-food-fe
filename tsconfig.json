{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "esnext",
    "strict": true,
    "paths": {
      "@/*": ["./app/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "core/config/expo-env.d.ts",
    "core/config/nativewind-env.d.ts",
    "src/**/*",
    "nativewind-env.d.ts",
    "expo-env.d.ts",
    "services/toastConfig.js"
  ]
}
